{
  "info": {
    "name": "Desafio QA - Sea Tecnologia - API /employees",
    "description": "Testes automatizados da API /employees. Testes que falham com o ID de um defeito entre colchetes documentam defeitos conhecidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Funções auxiliares disponíveis para todas as requisições.",
          "// Ficam guardadas em uma variável e são carregadas com eval() onde forem usadas.",
          "const helpers = function () {",
          "  return {",
          "    // Gera um CPF válido (com dígitos verificadores corretos) e aleatório,",
          "    // para não repetir CPF a cada execução.",
          "    gerarCpf() {",
          "      const n = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
          "      const dv = (base) => {",
          "        const soma = base.reduce((acc, num, i) => acc + num * (base.length + 1 - i), 0);",
          "        const resto = (soma * 10) % 11;",
          "        return resto === 10 ? 0 : resto;",
          "      };",
          "      n.push(dv(n));",
          "      n.push(dv(n));",
          "      return n.join('');",
          "    },",
          "    // Monta o corpo do funcionário a partir do modelo do ambiente (baseEmployee)",
          "    // e aplica os valores informados em \"alteracoes\".",
          "    montarFuncionario(alteracoes) {",
          "      const base = JSON.parse(pm.environment.get('baseEmployee') || '{}');",
          "      Object.entries(alteracoes || {}).forEach(([caminho, valor]) => this.definir(base, caminho, valor));",
          "      return base;",
          "    },",
          "    // Lê um campo por caminho com pontos. Ex.: ler(obj, 'state.employee.cpf')",
          "    ler(obj, caminho) {",
          "      return caminho.split('.').reduce((o, k) => (o == null ? undefined : o[k]), obj);",
          "    },",
          "    // Grava um campo por caminho com pontos, criando os objetos intermediários.",
          "    definir(obj, caminho, valor) {",
          "      const partes = caminho.split('.');",
          "      let atual = obj;",
          "      partes.slice(0, -1).forEach((k) => { if (typeof atual[k] !== 'object' || atual[k] === null) atual[k] = {}; atual = atual[k]; });",
          "      atual[partes[partes.length - 1]] = valor;",
          "    },",
          "    // Guarda o id de todo registro criado, para a limpeza no final.",
          "    registrarCriado(id) {",
          "      if (id === undefined || id === null) return;",
          "      const lista = JSON.parse(pm.collectionVariables.get('idsCriados') || '[]');",
          "      lista.push(id);",
          "      pm.collectionVariables.set('idsCriados', JSON.stringify(lista));",
          "    },",
          "  };",
          "};",
          "pm.collectionVariables.set('helpers', helpers.toString());",
          ""
        ]
      }
    }
  ],
