        },
        {
          "name": "SEC-03 - Cabeçalhos de segurança",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const h = (nome) => pm.response.headers.get(nome) || '';",
                  "",
                  "pm.test('CORS não deve liberar qualquer origem (*) [SEC-03]', () => {",
                  "  pm.expect(h('Access-Control-Allow-Origin')).to.not.include('*');",
                  "});",
                  "",
                  "pm.test('Resposta com dados pessoais não deve ter cache público [SEC-03]', () => {",
                  "  pm.expect(h('Cache-Control').toLowerCase()).to.not.include('public');",
                  "});",
                  "",
                  "pm.test('Servidor não deve revelar a tecnologia (X-Powered-By) [SEC-03]', () => {",
                  "  pm.expect(h('X-Powered-By')).to.eql('');",
                  "});",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            },
            "description": "Verifica cabeçalhos HTTP que afetam a segurança e a privacidade."
          }
        }
      ]
    },
    {
      "name": "99 - Limpeza",
      "item": [
        {
          "name": "Limpeza - apagar registros criados pelos testes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ids = JSON.parse(pm.collectionVariables.get('idsCriados') || '[]');",
                  "console.log('Limpeza: ' + ids.length + ' registro(s) para apagar: ' + ids.join(', '));",
                  "",
                  "ids.forEach((id) => {",
                  "  pm.sendRequest({ url: pm.environment.get('baseUrl') + '/employees/' + id, method: 'DELETE' }, (err, res) => {",
                  "    console.log('DELETE ' + id + ' -> ' + (err ? err.message : res.code));",
                  "  });",
                  "});",
                  "",
                  "pm.collectionVariables.set('idsCriados', '[]');",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            },
            "description": "Apaga todos os registros criados nesta execução, para não deixar lixo no ambiente compartilhado."
          }
        }
      ]
    }
  ]
}
