                  "});",
                  "",
                  "// Registro informativo para o relatório (aparece no console do Postman/Newman)",
                  "if (pm.response.code === 200) {",
                  "  const lista = pm.response.json();",
                  "  const emp = lista.length ? ((lista[0].state || {}).employee || lista[0]) : {};",
                  "  const campos = Object.keys(emp);",
                  "  console.log('SEC-01: ' + lista.length + ' registros retornados sem autenticação. Campos: ' + campos.join(', '));",
                  "}",
                  ""
                ]
              }
            }
          ],
